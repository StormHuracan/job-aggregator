APP_NAME=job-aggregator
APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_aggregator

# Адрес БД для backend в Compose: postgres — имя сервиса, порт внутри сети — 5432.
# При изменении POSTGRES_DB/USER/PASSWORD измените и этот URL.
# Спецсимволы логина/пароля в URL должны быть percent-encoded.
COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/job_aggregator
POSTGRES_PORT=5432
BACKEND_PORT=8000

POSTGRES_DB=job_aggregator        # ggignore
POSTGRES_USER=postgres            # ggignore
POSTGRES_PASSWORD=postgres        # ggignore

HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
HH_ALLOW_TOKEN_REFRESH=False

COLLECTION_DEFAULT_QUERY=python
COLLECTION_DEFAULT_AREA=
COLLECTION_PAGES_LIMIT=5

SCHEDULER_ENABLED=False
SCHEDULER_INTERVAL_MINUTES=60

# URL для PostgreSQL-тестов (отдельная БД, не рабочая)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_aggregator_test
