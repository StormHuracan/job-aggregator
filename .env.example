APP_NAME=job-aggregator
APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_aggregator

# Адрес БД для backend в Compose: postgres — имя сервиса, порт внутри сети — 5432.
# При изменении POSTGRES_DB/USER/PASSWORD измените и этот URL.
# Спецсимволы логина/пароля в URL должны быть percent-encoded.
COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/job_aggregator
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

POSTGRES_DB=job_aggregator        # ggignore
POSTGRES_USER=postgres            # ggignore
POSTGRES_PASSWORD=postgres        # ggignore

# Необязательно: без этих параметров используются встроенные ключи SDK
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Только для собственного OAuth-приложения с веб-callback
HH_REDIRECT_URI=
HH_ALLOW_TOKEN_REFRESH=False

COLLECTION_DEFAULT_QUERY=python
COLLECTION_DEFAULT_AREA=
COLLECTION_PAGES_LIMIT=5

# Автосбор включённых сохранённых поисков; создаёт новые совпадения для уведомлений.
# Для обычной работы: SCHEDULER_ENABLED=True, интервал 60 минут.
# Для проверки на защите: SCHEDULER_ENABLED=True, интервал 1 минута.
# Первый сбор начинается через указанный интервал, не сразу после запуска.
SCHEDULER_ENABLED=False
SCHEDULER_INTERVAL_MINUTES=60

# URL для PostgreSQL-тестов (отдельная БД, не рабочая)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_aggregator_test

# Telegram-уведомления
# Создайте бота через @BotFather и укажите его токен и username.
# Для локальной разработки бот по умолчанию отключён.
# Для включения задайте TELEGRAM_ENABLED=True и обе переменные ниже в .env.
# TELEGRAM_BOT_USERNAME — имя бота без https://t.me/ (например, my_jobs_bot).
# Настоящий токен храните только в .env; не добавляйте его в Git.
# Сначала привяжите пользователя к боту, затем запустите сбор сохранённых поисков:
# уведомления отправляются только о совпадениях, созданных после привязки.
# Ручной ad-hoc сбор не создаёт совпадения сохранённых поисков.
# После изменения .env пересоздайте backend: docker compose up -d --force-recreate backend
# Запускайте один backend worker/реплику и один экземпляр бота на этот токен.
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
