APP_NAME=job-aggregator
APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_aggregator

# HH.ru OAuth settings. Do not commit real secrets.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/auth/hh/callback

# Default collection settings for demo/manual runs.
COLLECTION_DEFAULT_QUERY=Python developer
COLLECTION_DEFAULT_AREA=
COLLECTION_PAGES_LIMIT=2

# Scheduler is disabled by default for local tests/development.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60
